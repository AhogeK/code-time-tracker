# Build-time sync configuration for the code-time-tracker plugin.
# Copy this file to .env and adjust the values; a release build only changes
# these values, never the code.
# Resolution order: -Pctt.* Gradle property > CTT_* environment variable >
# .env file > development defaults.

# Web console URL opened by the "Get an API key" button (where users create API keys).
CTT_WEB_URL=http://localhost:5173/

# Default ctt-server URL. Users can still override this in the plugin settings page.
# CTT_SERVER_URL=http://localhost:8080/ctt-server
